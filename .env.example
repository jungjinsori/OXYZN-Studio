# OXYZN Studio — 빌드 내장용 API 키
# 이 파일을 복사해 `.env.local` 을 만들고 실제 키를 채운 뒤 빌드하세요.
#   cp .env.example .env.local
# `.env.local` 은 .gitignore(*.local)로 커밋되지 않습니다.
# vite build 시 VITE_* 값이 앱 번들에 내장됩니다.
# (앱 설정 화면에서 직접 입력한 값이 있으면 그 값이 우선합니다.)

# fal.ai — 이미지·영상·음악·TTS·보이스 클로닝 전부 이 키 하나로 사용
#   영상: Seedance 2.0 (text/image/reference-to-video)
#   이미지: GPT Image 2 (+ /edit 부분수정)
#   사운드: ElevenLabs Music, MiniMax Speech 2.8 Turbo, MiniMax Voice Clone
VITE_FAL_API_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# BytePlus ModelArk — ByteDance 공식 클라우드 직접 연동 (선택)
#   영상: Seedance 2.0 (asset:// 신뢰 자산·실인물 인증 자산 사용 가능)
#   이미지: Seedream 5.0
#   리전 ap-southeast · 콘솔에서 선불 리소스 팩 구매 후 모델 활성화 필요
VITE_ARK_API_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# BytePlus Access Key (AK/SK) — 배우 인증(Assets API) 전용 (선택)
#   위 Bearer 키로는 Assets API 를 호출할 수 없다. 문서 명시:
#   "To call the Assets API interface, you must use Access Key authentication."
#   발급: 콘솔 → 계정명 → IAM → Key management → Create access key
#   ㄴ Secret 은 발급 시 1회만 표시된다. 계정 1개당 최대 2쌍.
#   조건: 해당 프로젝트의 ArkFullAccess 권한 + Advanced Creation Rights Entry 이상
#   ★ 여기에 더해 계정에 Advanced 또는 Premium 구독 플랜이 있어야 한다.
#     플랜이 없으면 키·권한이 멀쩡해도 403 이 난다
#     ("This API requires an active subscription"). 선불 리소스 팩과는 별개다.
VITE_ARK_ACCESS_KEY_ID=AKLTxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_ARK_SECRET_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Claude (시나리오 각색/분석, 프롬프트 생성)
VITE_CLAUDE_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Google Gemini (영상 분석)
VITE_GOOGLE_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

